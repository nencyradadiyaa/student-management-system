<%- include('../partials/header') %>

<div class="app-container">
  <!-- Sidebar -->
  <%- include('../partials/sidebar') %>

  <div class="app-content">
    <!-- Navbar -->
    <%- include('../partials/navbar') %>

    <div class="content-body">
      
      <!-- Feedback Alerts -->
      <% if (success) { %>
        <div class="alert alert-success alert-dismiss border-0 shadow-sm d-flex align-items-center py-2 px-3 mb-4" role="alert">
          <i class="fa-solid fa-circle-check me-2"></i>
          <div><%= success %></div>
        </div>
      <% } %>
      
      <% if (error) { %>
        <div class="alert alert-danger alert-dismiss border-0 shadow-sm d-flex align-items-center py-2 px-3 mb-4" role="alert">
          <i class="fa-solid fa-circle-exclamation me-2"></i>
          <div><%= error %></div>
        </div>
      <% } %>

      <!-- Dynamic URL Helper Utilities inside template -->
      <%
        const getSortLink = (field) => {
          let order = 'ASC';
          if (filters.sortBy === field && filters.sortOrder === 'ASC') {
            order = 'DESC';
          }
          const params = new URLSearchParams({
            ...filters,
            sortBy: field,
            sortOrder: order,
            page: 1
          });
          return '?' + params.toString();
        };

        const getPageLink = (p) => {
          const params = new URLSearchParams({
            ...filters,
            page: p
          });
          return '?' + params.toString();
        };

        const getExcelLink = () => {
          const params = new URLSearchParams({
            ...filters
          });
          return '/exports/excel?' + params.toString();
        };
      %>

      <!-- Filter Panel -->
      <div class="row mb-4">
        <div class="col-12">
          <div class="glass-card p-4">
            <h5 class="fw-bold text-primary mb-3"><i class="fa-solid fa-filter me-2"></i>Filter Student Directory</h5>
            
            <form action="/students" method="GET">
              <!-- Preserve sorting defaults -->
              <input type="hidden" name="sortBy" value="<%= filters.sortBy %>">
              <input type="hidden" name="sortOrder" value="<%= filters.sortOrder %>">
              <input type="hidden" name="limit" value="<%= filters.limit %>">

              <div class="row g-3">
                <!-- Search Keyword -->
                <div class="col-12 col-md-4">
                  <label class="form-label small text-secondary fw-semibold">Search Student</label>
                  <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" class="form-control border-start-0 ps-0" name="search" value="<%= filters.search %>" placeholder="Name, enrollment or email...">
                  </div>
                </div>

                <!-- Department Selector -->
                <div class="col-6 col-md-3">
                  <label class="form-label small text-secondary fw-semibold">Department</label>
                  <select class="form-select" name="departmentId">
                    <option value="">All Departments</option>
                    <% departments.forEach(dept => { %>
                      <option value="<%= dept.id %>" <%= filters.departmentId == dept.id ? 'selected' : '' %>><%= dept.name %> (<%= dept.code %>)</option>
                    <% }) %>
                  </select>
                </div>

                <!-- Semester Selector -->
                <div class="col-6 col-md-2">
                  <label class="form-label small text-secondary fw-semibold">Semester</label>
                  <select class="form-select" name="semester">
                    <option value="">All Semesters</option>
                    <% for(let i = 1; i <= 8; i++) { %>
                      <option value="<%= i %>" <%= filters.semester == i ? 'selected' : '' %>>Semester <%= i %></option>
                    <% } %>
                  </select>
                </div>

                <!-- Gender Selector -->
                <div class="col-6 col-md-2">
                  <label class="form-label small text-secondary fw-semibold">Gender</label>
                  <select class="form-select" name="gender">
                    <option value="">All Genders</option>
                    <option value="Male" <%= filters.gender === 'Male' ? 'selected' : '' %>>Male</option>
                    <option value="Female" <%= filters.gender === 'Female' ? 'selected' : '' %>>Female</option>
                    <option value="Other" <%= filters.gender === 'Other' ? 'selected' : '' %>>Other</option>
                  </select>
                </div>

                <!-- Submit / Clear Buttons -->
                <div class="col-6 col-md-1 d-flex align-items-end">
                  <button type="submit" class="btn btn-primary w-100 px-0" title="Apply Filters">
                    <i class="fa-solid fa-check"></i>
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>

      <!-- Students Table Directory -->
      <div class="row">
        <div class="col-12">
          <div class="glass-card p-4">
            
            <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4">
              <div>
                <h5 class="fw-bold text-primary mb-1">Student Registry List</h5>
                <p class="text-secondary small mb-0">Showing <%= students.length %> of <%= total %> records registered</p>
              </div>
              
              <div class="d-flex gap-2">
                <a href="<%= getExcelLink() %>" class="btn btn-light border d-flex align-items-center gap-2">
                  <i class="fa-solid fa-file-excel text-success"></i>
                  <span>Export Excel</span>
                </a>
                <a href="/students/create" class="btn btn-primary d-flex align-items-center gap-2">
                  <i class="fa-solid fa-plus"></i>
                  <span>Add New</span>
                </a>
              </div>
            </div>

            <% if (students.length === 0) { %>
              <div class="text-center py-5 text-secondary">
                <i class="fa-regular fa-folder-open fa-3x mb-3 text-muted"></i>
                <h5 class="fw-bold">No Students Found</h5>
                <p class="small mb-0">Try adjusting your filters or typing a different search keyword.</p>
              </div>
            <% } else { %>
              <div class="table-responsive">
                <table class="table custom-table table-hover">
                  <thead>
                    <tr>
                      <th>
                        <a href="<%= getSortLink('full_name') %>" class="text-decoration-none text-secondary">
                          Student Name 
                          <% if (filters.sortBy === 'full_name') { %>
                            <i class="fa-solid <%= filters.sortOrder === 'ASC' ? 'fa-arrow-up-short-wide' : 'fa-arrow-down-wide-short' %> ms-1"></i>
                          <% } %>
                        </a>
                      </th>
                      <th>
                        <a href="<%= getSortLink('enrollment_number') %>" class="text-decoration-none text-secondary">
                          Enrollment 
                          <% if (filters.sortBy === 'enrollment_number') { %>
                            <i class="fa-solid <%= filters.sortOrder === 'ASC' ? 'fa-arrow-up-short-wide' : 'fa-arrow-down-wide-short' %> ms-1"></i>
                          <% } %>
                        </a>
                      </th>
                      <th>Email</th>
                      <th>
                        <a href="<%= getSortLink('department') %>" class="text-decoration-none text-secondary">
                          Department 
                          <% if (filters.sortBy === 'department') { %>
                            <i class="fa-solid <%= filters.sortOrder === 'ASC' ? 'fa-arrow-up-short-wide' : 'fa-arrow-down-wide-short' %> ms-1"></i>
                          <% } %>
                        </a>
                      </th>
                      <th>
                        <a href="<%= getSortLink('semester') %>" class="text-decoration-none text-secondary">
                          Sem
                          <% if (filters.sortBy === 'semester') { %>
                            <i class="fa-solid <%= filters.sortOrder === 'ASC' ? 'fa-arrow-up-short-wide' : 'fa-arrow-down-wide-short' %> ms-1"></i>
                          <% } %>
                        </a>
                      </th>
                      <th class="text-end no-print">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% students.forEach(student => { %>
                      <tr>
                        <td>
                          <div class="d-flex align-items-center">
                            <% if (student.profile_pic) { %>
                              <img src="/uploads/<%= student.profile_pic %>" class="profile-avatar-sm me-3 border shadow-sm" alt="Avatar">
                            <% } else { %>
                              <div class="d-inline-flex align-items-center justify-content-center text-white rounded-circle me-3" 
                                   style="width: 42px; height: 42px; background-color: var(--accent); font-size: 0.9rem; font-weight: 600; box-shadow: var(--shadow-sm);">
                                <%= student.full_name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2) %>
                              </div>
                            <% } %>
                            <div>
                              <span class="fw-semibold text-primary block"><%= student.full_name %></span>
                              <span class="text-muted d-block" style="font-size: 0.8rem;"><%= student.phone || 'No phone' %></span>
                            </div>
                          </div>
                        </td>
                        <td>
                          <span class="badge bg-light text-secondary border font-monospace" style="font-size: 0.85rem;"><%= student.enrollment_number %></span>
                        </td>
                        <td class="small"><%= student.email %></td>
                        <td>
                          <span class="fw-medium"><%= student.department_name || 'N/A' %></span>
                          <span class="text-muted small d-block" style="font-size: 0.75rem;"><%= student.department_code || '' %></span>
                        </td>
                        <td>
                          <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">S<%= student.semester %></span>
                        </td>
                        <td class="text-end no-print">
                          <div class="dropdown">
                            <button class="btn btn-sm btn-light border px-2 py-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                              <i class="fa-solid fa-ellipsis-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-md border-0" style="background-color: var(--bg-card);">
                              <li>
                                <a class="dropdown-item py-2" href="/students/show/<%= student.id %>">
                                  <i class="fa-regular fa-user text-primary me-2"></i> View Profile
                                </a>
                              </li>
                              <li>
                                <a class="dropdown-item py-2" href="/students/edit/<%= student.id %>">
                                  <i class="fa-regular fa-edit text-warning-emphasis me-2"></i> Edit Record
                                </a>
                              </li>
                              <li><hr class="dropdown-divider"></li>
                              <li>
                                <form action="/students/delete/<%= student.id %>" method="POST" onsubmit="return confirm('WARNING: Are you absolutely sure you want to permanently delete this student record? This action will destroy all associated attendance and marks histories.');">
                                  <button type="submit" class="dropdown-item py-2 text-danger">
                                    <i class="fa-regular fa-trash-can me-2"></i> Delete Student
                                  </button>
                                </form>
                              </li>
                            </ul>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>

              <!-- Pagination Footer Navigation -->
              <% if (totalPages > 1) { %>
                <nav class="d-flex justify-content-between align-items-center mt-4">
                  <span class="text-secondary small">Page <%= currentPage %> of <%= totalPages %></span>
                  <ul class="pagination pagination-sm mb-0">
                    <!-- Prev Page Link -->
                    <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                      <a class="page-link" href="<%= currentPage === 1 ? '#' : getPageLink(currentPage - 1) %>" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                      </a>
                    </li>
                    
                    <!-- Page Number Loops -->
                    <% for(let i = 1; i <= totalPages; i++) { %>
                      <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                        <a class="page-link" href="<%= getPageLink(i) %>"><%= i %></a>
                      </li>
                    <% } %>
                    
                    <!-- Next Page Link -->
                    <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                      <a class="page-link" href="<%= currentPage === totalPages ? '#' : getPageLink(currentPage + 1) %>" aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                      </a>
                    </li>
                  </ul>
                </nav>
              <% } %>
            <% } %>

          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
