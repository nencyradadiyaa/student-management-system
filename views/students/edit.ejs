<%- include('../partials/header') %>

<div class="app-container">
  <!-- Sidebar -->
  <%- include('../partials/sidebar') %>

  <div class="app-content">
    <!-- Navbar -->
    <%- include('../partials/navbar') %>

    <div class="content-body">
      
      <!-- Back Link -->
      <div class="mb-4">
        <a href="/students" class="text-decoration-none text-secondary d-inline-flex align-items-center gap-1">
          <i class="fa-solid fa-arrow-left"></i>
          <span>Back to Students List</span>
        </a>
      </div>

      <!-- Form Card -->
      <div class="row">
        <div class="col-12 col-xl-10 mx-auto">
          <div class="glass-card p-4">
            
            <div class="mb-4 border-bottom pb-3">
              <h5 class="fw-bold text-primary mb-1">Edit Student Profile</h5>
              <p class="text-secondary small mb-0">Update academic, personal or contact records for <%= student.full_name %>.</p>
            </div>

            <!-- Errors Display -->
            <% if (errors && errors.length > 0) { %>
              <div class="alert alert-danger border-0 shadow-sm mb-4" role="alert">
                <h6 class="fw-bold mb-2"><i class="fa-solid fa-circle-exclamation me-2"></i>Please resolve the following errors:</h6>
                <ul class="mb-0 small ps-3">
                  <% errors.forEach(err => { %>
                    <li><%= err %></li>
                  <% }) %>
                </ul>
              </div>
            <% } %>

            <!-- Edit Form -->
            <form action="/students/edit/<%= student.id %>" method="POST" enctype="multipart/form-data">
              
              <!-- Section 1: Academic Identity -->
              <h6 class="text-primary fw-bold mb-3"><i class="fa-solid fa-address-card me-2"></i>Academic Credentials</h6>
              <div class="row g-3 mb-4">
                <!-- Enrollment Number -->
                <div class="col-12 col-md-6">
                  <label for="enrollment_number" class="form-label small text-secondary fw-semibold">Enrollment Number <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" id="enrollment_number" name="enrollment_number" 
                         value="<%= student.enrollment_number || '' %>" placeholder="e.g. ENR2026099" required>
                </div>
                
                <!-- Department -->
                <div class="col-12 col-sm-6 col-md-3">
                  <label for="department_id" class="form-label small text-secondary fw-semibold">Department</label>
                  <select class="form-select" id="department_id" name="department_id">
                    <option value="">Select Department</option>
                    <% departments.forEach(dept => { %>
                      <option value="<%= dept.id %>" <%= student.department_id == dept.id ? 'selected' : '' %>><%= dept.name %> (<%= dept.code %>)</option>
                    <% }) %>
                  </select>
                </div>

                <!-- Semester -->
                <div class="col-12 col-sm-6 col-md-3">
                  <label for="semester" class="form-label small text-secondary fw-semibold">Semester</label>
                  <select class="form-select" id="semester" name="semester">
                    <% for(let i = 1; i <= 8; i++) { %>
                      <option value="<%= i %>" <%= student.semester == i ? 'selected' : '' %>>Semester <%= i %></option>
                    <% } %>
                  </select>
                </div>
              </div>

              <!-- Section 2: Personal Details -->
              <h6 class="text-primary fw-bold mb-3"><i class="fa-solid fa-user me-2"></i>Personal Details</h6>
              <div class="row g-3 mb-4">
                <!-- Full Name -->
                <div class="col-12 col-md-6">
                  <label for="full_name" class="form-label small text-secondary fw-semibold">Full Name <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" id="full_name" name="full_name" 
                         value="<%= student.full_name || '' %>" placeholder="e.g. John Doe" required>
                </div>

                <!-- Gender -->
                <div class="col-6 col-md-3">
                  <label for="gender" class="form-label small text-secondary fw-semibold">Gender</label>
                  <select class="form-select" id="gender" name="gender">
                    <option value="Male" <%= student.gender === 'Male' ? 'selected' : '' %>>Male</option>
                    <option value="Female" <%= student.gender === 'Female' ? 'selected' : '' %>>Female</option>
                    <option value="Other" <%= student.gender === 'Other' ? 'selected' : '' %>>Other</option>
                  </select>
                </div>

                <!-- Date of Birth -->
                <div class="col-6 col-md-3">
                  <label for="dob" class="form-label small text-secondary fw-semibold">Date of Birth</label>
                  <input type="date" class="form-control" id="dob" name="dob" 
                         value="<%= student.dob ? student.dob.split(' ')[0] : '' %>">
                </div>
              </div>

              <!-- Section 3: Contact Details -->
              <h6 class="text-primary fw-bold mb-3"><i class="fa-solid fa-envelope me-2"></i>Contact Information</h6>
              <div class="row g-3 mb-4">
                <!-- Email Address -->
                <div class="col-12 col-md-6">
                  <label for="email" class="form-label small text-secondary fw-semibold">Email Address <span class="text-danger">*</span></label>
                  <input type="email" class="form-control" id="email" name="email" 
                         value="<%= student.email || '' %>" placeholder="john.doe@email.com" required>
                </div>

                <!-- Phone Number -->
                <div class="col-12 col-md-6">
                  <label for="phone" class="form-label small text-secondary fw-semibold">Phone Number</label>
                  <input type="tel" class="form-control" id="phone" name="phone" 
                         value="<%= student.phone || '' %>" placeholder="9876543210">
                </div>

                <!-- Address -->
                <div class="col-12">
                  <label for="address" class="form-label small text-secondary fw-semibold">Residential Address</label>
                  <textarea class="form-control" id="address" name="address" rows="3" placeholder="Enter complete home address..."><%= student.address || '' %></textarea>
                </div>
              </div>

              <!-- Section 4: Picture Upload & Preview -->
              <h6 class="text-primary fw-bold mb-3"><i class="fa-solid fa-image me-2"></i>Profile Picture</h6>
              <div class="row g-3 mb-4 align-items-center">
                <!-- Image Preview Thumb -->
                <div class="col-auto">
                  <% if (student.profile_pic) { %>
                    <img src="/uploads/<%= student.profile_pic %>" class="border rounded-3" style="width: 80px; height: 80px; object-fit: cover;" alt="Current Profile Picture">
                  <% } else { %>
                    <div class="d-flex align-items-center justify-content-center text-white rounded-3 border" 
                         style="width: 80px; height: 80px; background-color: var(--accent); font-size: 1.5rem; font-weight: 600;">
                      <%= student.full_name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2) %>
                    </div>
                  <% } %>
                </div>

                <!-- File Selector -->
                <div class="col">
                  <label for="profile_pic" class="form-label small text-secondary fw-semibold">Replace Photo (Optional)</label>
                  <input class="form-control" type="file" id="profile_pic" name="profile_pic" accept="image/jpeg,image/png,image/webp">
                  <div class="form-text small text-muted">Leave empty to keep current picture. Supports JPEG, PNG, or WEBP. Max 2MB.</div>
                </div>
              </div>

              <!-- Submit Panel -->
              <div class="mt-4 pt-3 border-top d-flex gap-2 justify-content-end">
                <a href="/students" class="btn btn-light border px-4">Cancel</a>
                <button type="submit" class="btn btn-primary px-4 shadow-sm">Save Changes</button>
              </div>

            </form>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
