<div class="app-sidebar" id="appSidebar">
  <div class="sidebar-header">
    <div class="d-flex align-items-center justify-content-center bg-primary rounded-3 text-white" style="width: 40px; height: 40px; background-color: var(--accent) !important;">
      <i class="fa-solid fa-graduation-cap fa-lg"></i>
    </div>
    <a href="/dashboard" class="sidebar-logo">SMS Portal</a>
  </div>
  
  <ul class="sidebar-menu">
    <li class="menu-item <%= title === 'Admin Dashboard' ? 'active' : '' %>">
      <a href="/dashboard">
        <i class="fa-solid fa-chart-line"></i> 
        <span>Dashboard</span>
      </a>
    </li>
    <li class="menu-item <%= title.includes('Student') || title.includes('Add Student') || title.includes('Edit') ? 'active' : '' %>">
      <a href="/students">
        <i class="fa-solid fa-user-graduate"></i> 
        <span>Students</span>
      </a>
    </li>
    <li class="menu-item <%= title.includes('Attendance') ? 'active' : '' %>">
      <a href="/attendance">
        <i class="fa-solid fa-calendar-check"></i> 
        <span>Attendance</span>
      </a>
    </li>
    <li class="menu-item <%= title.includes('Marks') || title.includes('Grade') ? 'active' : '' %>">
      <a href="/marks">
        <i class="fa-solid fa-clipboard-list"></i> 
        <span>Grades Sheet</span>
      </a>
    </li>
  </ul>
  
  <div class="sidebar-footer">
    <div class="menu-item">
      <a href="/auth/logout" class="text-danger-emphasis">
        <i class="fa-solid fa-power-off"></i> 
        <span>Logout</span>
      </a>
    </div>
  </div>
</div>
