<%- include('../partials/header') %>

<div class="app-container">
  <!-- Sidebar -->
  <%- include('../partials/sidebar') %>

  <div class="app-content">
    <!-- Navbar -->
    <%- include('../partials/navbar') %>

    <div class="content-body">
      
      <!-- Back Link -->
      <div class="mb-4">
        <a href="/marks?departmentId=<%= student.department_id %>&semester=<%= student.semester %>" class="text-decoration-none text-secondary d-inline-flex align-items-center gap-1">
          <i class="fa-solid fa-arrow-left"></i>
          <span>Back to Class Grades Sheet</span>
        </a>
      </div>

      <!-- Feedback Toast Panels -->
      <% if (success) { %>
        <div class="alert alert-success alert-dismiss border-0 shadow-sm d-flex align-items-center py-2 px-3 mb-4" role="alert">
          <i class="fa-solid fa-circle-check me-2"></i>
          <div><%= success %></div>
        </div>
      <% } %>
      
      <% if (error) { %>
        <div class="alert alert-danger alert-dismiss border-0 shadow-sm d-flex align-items-center py-2 px-3 mb-4" role="alert">
          <i class="fa-solid fa-circle-exclamation me-2"></i>
          <div><%= error %></div>
        </div>
      <% } %>

      <!-- Main Layout Panels -->
      <div class="row g-4">
        
        <!-- Left: Student Report Card Table -->
        <div class="col-12 col-lg-7">
          <div class="glass-card p-4">
            
            <div class="mb-4 border-bottom pb-2">
              <h5 class="fw-bold text-primary mb-1">Academic Grade Card</h5>
              <p class="text-secondary small mb-0">
                Student: <span class="fw-semibold text-primary"><%= student.full_name %></span> | Enrollment: <span class="badge bg-light text-secondary border font-monospace"><%= student.enrollment_number %></span>
              </p>
            </div>

            <% if (marksList.length === 0) { %>
              <div class="text-center py-5 text-secondary">
                <i class="fa-solid fa-file-pen fa-3x mb-3 text-muted"></i>
                <h6 class="fw-bold">No Grades Recorded</h6>
                <p class="small mb-0">Use the entry form on the right to add the first examination score.</p>
              </div>
            <% } else { %>
              <div class="table-responsive">
                <table class="table custom-table table-hover">
                  <thead>
                    <tr>
                      <th>Subject</th>
                      <th class="text-center">Sem</th>
                      <th class="text-center">Marks</th>
                      <th class="text-center">%</th>
                      <th class="text-end">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% marksList.forEach(m => { %>
                      <% const percentage = ((parseFloat(m.marks_obtained) / parseFloat(m.max_marks)) * 100).toFixed(1); %>
                      <tr>
                        <td>
                          <span class="fw-semibold text-primary"><%= m.subject_name %></span>
                          <span class="text-muted d-block small" style="font-size: 0.75rem;"><%= m.exam_date || 'No Date' %></span>
                        </td>
                        <td class="text-center">S<%= m.semester %></td>
                        <td class="text-center">
                          <span class="fw-semibold"><%= parseFloat(m.marks_obtained).toFixed(1) %></span>
                          <span class="text-muted small">/ <%= parseFloat(m.max_marks).toFixed(1) %></span>
                        </td>
                        <td class="text-center">
                          <span class="fw-bold text-indigo" style="color: var(--accent);"><%= percentage %>%</span>
                        </td>
                        <td class="text-end">
                          <div class="d-flex gap-2 justify-content-end">
                            <!-- Edit trigger links back to this page with query params -->
                            <a href="?editMarkId=<%= m.id %>" class="btn btn-sm btn-light border px-2 py-1" title="Edit Mark">
                              <i class="fa-regular fa-edit text-warning-emphasis"></i>
                            </a>
                            
                            <!-- Delete form -->
                            <form action="/marks/student/<%= student.id %>/delete/<%= m.id %>" method="POST"
                                  onsubmit="return confirm('Remove grade for subject: <%= m.subject_name %>?');">
                              <button type="submit" class="btn btn-sm btn-light border px-2 py-1 text-danger" title="Delete Mark">
                                <i class="fa-regular fa-trash-can"></i>
                              </button>
                            </form>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>

          </div>
        </div>

        <!-- Right: Grades Form (Handles Add and Edit contexts dynamically) -->
        <div class="col-12 col-lg-5">
          <div class="glass-card p-4">
            
            <div class="mb-4 border-bottom pb-2">
              <h5 class="fw-bold text-primary mb-1">
                <%= editMark ? 'Edit Subject Grade' : 'Add Subject Grade' %>
              </h5>
              <p class="text-secondary small mb-0">
                <%= editMark ? 'Modify the selected exam result details below.' : 'Record a new examination result for the student.' %>
              </p>
            </div>

            <!-- Grade card save form -->
            <form action="/marks/student/<%= student.id %>/save" method="POST">
              <!-- Edit check ID -->
              <% if (editMark) { %>
                <input type="hidden" name="id" value="<%= editMark.id %>">
              <% } %>

              <!-- Semester Setting (pre-selected to student's current semester) -->
              <div class="mb-3">
                <label for="semester" class="form-label small text-secondary fw-semibold">Semester</label>
                <select class="form-select" id="semester" name="semester" required>
                  <% for(let i = 1; i <= 8; i++) { %>
                    <option value="<%= i %>" <%= (editMark ? editMark.semester : student.semester) == i ? 'selected' : '' %>>Semester <%= i %></option>
                  <% } %>
                </select>
              </div>

              <!-- Subject Name -->
              <div class="mb-3">
                <label for="subject_name" class="form-label small text-secondary fw-semibold">Subject Name</label>
                <input type="text" class="form-control" id="subject_name" name="subject_name" 
                       value="<%= editMark ? editMark.subject_name : '' %>" 
                       placeholder="e.g. Mathematics II" required>
              </div>

              <div class="row g-2 mb-3">
                <!-- Marks Obtained -->
                <div class="col-6">
                  <label for="marks_obtained" class="form-label small text-secondary fw-semibold">Obtained Marks</label>
                  <input type="number" step="0.01" class="form-control" id="marks_obtained" name="marks_obtained" 
                         value="<%= editMark ? editMark.marks_obtained : '' %>" 
                         placeholder="e.g. 85.50" required>
                </div>
                
                <!-- Max Marks -->
                <div class="col-6">
                  <label for="max_marks" class="form-label small text-secondary fw-semibold">Maximum Marks</label>
                  <input type="number" step="0.01" class="form-control" id="max_marks" name="max_marks" 
                         value="<%= editMark ? editMark.max_marks : '100.00' %>" 
                         placeholder="100.00" required>
                </div>
              </div>

              <!-- Exam Date -->
              <div class="mb-4">
                <label for="exam_date" class="form-label small text-secondary fw-semibold">Examination Date</label>
                <input type="date" class="form-control" id="exam_date" name="exam_date" 
                       value="<%= editMark && editMark.exam_date ? editMark.exam_date.split(' ')[0] : '' %>">
              </div>

              <!-- Submit panel -->
              <div class="d-flex gap-2 justify-content-end border-top pt-3">
                <% if (editMark) { %>
                  <a href="/marks/student/<%= student.id %>" class="btn btn-sm btn-light border">Cancel Edit</a>
                <% } %>
                <button type="submit" class="btn btn-sm btn-primary shadow-sm px-4">
                  <%= editMark ? 'Update Score' : 'Record Score' %>
                </button>
              </div>

            </form>
          </div>
        </div>

      </div>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
