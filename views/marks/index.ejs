<%- include('../partials/header') %>

<div class="app-container">
  <!-- Sidebar -->
  <%- include('../partials/sidebar') %>

  <div class="app-content">
    <!-- Navbar -->
    <%- include('../partials/navbar') %>

    <div class="content-body">
      
      <!-- Feedback Toasts -->
      <% if (success) { %>
        <div class="alert alert-success alert-dismiss border-0 shadow-sm d-flex align-items-center py-2 px-3 mb-4" role="alert">
          <i class="fa-solid fa-circle-check me-2"></i>
          <div><%= success %></div>
        </div>
      <% } %>
      
      <% if (error) { %>
        <div class="alert alert-danger alert-dismiss border-0 shadow-sm d-flex align-items-center py-2 px-3 mb-4" role="alert">
          <i class="fa-solid fa-circle-exclamation me-2"></i>
          <div><%= error %></div>
        </div>
      <% } %>

      <!-- Class Selector Header -->
      <div class="row mb-4">
        <div class="col-12">
          <div class="glass-card p-4">
            <h5 class="fw-bold text-primary mb-3"><i class="fa-solid fa-clipboard-list me-2"></i>Select Department & Semester</h5>
            
            <form action="/marks" method="GET">
              <div class="row g-3 align-items-end">
                <!-- Department Selection -->
                <div class="col-12 col-sm-6 col-md-5">
                  <label for="departmentId" class="form-label small text-secondary fw-semibold">Department</label>
                  <select class="form-select" id="departmentId" name="departmentId" required>
                    <option value="">Choose Department...</option>
                    <% departments.forEach(dept => { %>
                      <option value="<%= dept.id %>" <%= filters.departmentId == dept.id ? 'selected' : '' %>><%= dept.name %> (<%= dept.code %>)</option>
                    <% }) %>
                  </select>
                </div>

                <!-- Semester Selection -->
                <div class="col-12 col-sm-6 col-md-4">
                  <label for="semester" class="form-label small text-secondary fw-semibold">Semester</label>
                  <select class="form-select" id="semester" name="semester" required>
                    <option value="">Choose Semester...</option>
                    <% for(let i = 1; i <= 8; i++) { %>
                      <option value="<%= i %>" <%= filters.semester == i ? 'selected' : '' %>>Semester <%= i %></option>
                    <% } %>
                  </select>
                </div>

                <!-- Load Sheet Button -->
                <div class="col-12 col-md-3">
                  <button type="submit" class="btn btn-primary w-100 shadow-sm d-flex align-items-center justify-content-center gap-2">
                    <i class="fa-solid fa-graduation-cap"></i>
                    <span>Load Grades Panel</span>
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>

      <!-- Class Analysis & Student Rosters -->
      <% if (!filters.departmentId || !filters.semester) { %>
        <div class="row">
          <div class="col-12">
            <div class="glass-card p-5 text-center text-secondary">
              <i class="fa-solid fa-sheet-plastic fa-3x mb-3 text-muted"></i>
              <h5 class="fw-bold">No Class Selected</h5>
              <p class="small mb-0">Select a department and semester above to manage student grades and view class averages.</p>
            </div>
          </div>
        </div>
      <% } else { %>
        <!-- Section 1: Subject Averages / Statistics -->
        <div class="row g-4 mb-4">
          <div class="col-12">
            <div class="glass-card p-4">
              <h5 class="fw-bold text-primary mb-3"><i class="fa-solid fa-chart-simple me-2"></i>Class Performance Averages</h5>
              
              <% if (classPerformance.length === 0) { %>
                <p class="text-secondary small mb-0">No exam results recorded for subjects in this semester yet.</p>
              <% } else { %>
                <div class="row g-3">
                  <% classPerformance.forEach(subj => { %>
                    <div class="col-12 col-md-4">
                      <div class="border rounded p-3 bg-light-subtle">
                        <span class="fw-bold text-primary d-block text-truncate mb-2" style="font-size: 0.95rem;" title="<%= subj.subject_name %>">
                          <%= subj.subject_name %>
                        </span>
                        <div class="row text-center g-2 mt-1 border-top pt-2">
                          <div class="col-4 border-end">
                            <span class="text-muted d-block" style="font-size: 0.7rem; text-transform: uppercase;">Average</span>
                            <span class="fw-bold text-indigo" style="color: var(--accent);"><%= parseFloat(subj.avg_obtained).toFixed(1) %>%</span>
                          </div>
                          <div class="col-4 border-end">
                            <span class="text-muted d-block" style="font-size: 0.7rem; text-transform: uppercase;">Highest</span>
                            <span class="fw-bold text-success"><%= parseFloat(subj.max_obtained).toFixed(1) %></span>
                          </div>
                          <div class="col-4">
                            <span class="text-muted d-block" style="font-size: 0.7rem; text-transform: uppercase;">Lowest</span>
                            <span class="fw-bold text-danger"><%= parseFloat(subj.min_obtained).toFixed(1) %></span>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Section 2: Student Catalog List -->
        <div class="row">
          <div class="col-12">
            <div class="glass-card p-4">
              <h5 class="fw-bold text-primary mb-3"><i class="fa-solid fa-user-graduate me-2"></i>Class Roll List</h5>
              
              <% if (students.length === 0) { %>
                <p class="text-secondary text-center py-4 mb-0">No students are currently registered in this class.</p>
              <% } else { %>
                <div class="table-responsive">
                  <table class="table custom-table table-hover">
                    <thead>
                      <tr>
                        <th>Student Name</th>
                        <th>Enrollment Number</th>
                        <th>Semester</th>
                        <th class="text-end">Academic Action</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% students.forEach(student => { %>
                        <tr>
                          <td>
                            <span class="fw-semibold text-primary"><%= student.full_name %></span>
                          </td>
                          <td>
                            <span class="badge bg-light text-secondary border font-monospace" style="font-size: 0.85rem;"><%= student.enrollment_number %></span>
                          </td>
                          <td>
                            <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-2">S<%= student.semester %></span>
                          </td>
                          <td class="text-end">
                            <a href="/marks/student/<%= student.id %>" class="btn btn-sm btn-light border px-3">
                              <i class="fa-solid fa-file-signature text-indigo me-1" style="color: var(--accent);"></i> Manage Report Card
                            </a>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      <% } %>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
